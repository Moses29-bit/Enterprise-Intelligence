Options -Indexes
RewriteEngine On

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "(^\.git|\.(sql|dump|bak|log|ini)$)">
  Require all denied
</FilesMatch>

RewriteRule ^(backend|database|bin|tests|docs|deploy|frontend)(?:/|$) - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [QSA,L]
