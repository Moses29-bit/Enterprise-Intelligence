Options -Indexes
RewriteEngine On

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "(^\.git|^composer\.(json|lock)$|\.(sql|dump|bak|log|ini)$)">
  Require all denied
</FilesMatch>

RewriteRule ^(backend|database|bin|vendor|tests|docs|deploy|frontend)(?:/|$) - [F,L]
RewriteRule ^(?!api(?:/|$)).+\.php$ - [F,L]

RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [QSA,L]
