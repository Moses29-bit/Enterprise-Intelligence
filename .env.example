APP_ENV=local
APP_KEY=
APP_URL=http://localhost/Enterprise%20Intelligence
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vantiq
DB_USER=root
DB_PASSWORD=

# Password reset is unavailable until mail transport is explicitly configured.
MAIL_TRANSPORT=
MAIL_FROM=
RESET_URL=http://localhost:5173/reset-password
PRIVATE_STORAGE_PATH=/home/ACCOUNT/vantiq-private-storage

# Copy this file to .env and replace APP_KEY with a secret generated by:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
