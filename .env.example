APP_ENV=local
APP_KEY=
APP_URL=http://localhost/Enterprise%20Intelligence
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=43200
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vantiq
DB_USER=root
DB_PASSWORD=

# Password reset is unavailable until mail transport is explicitly configured.
MAIL_TRANSPORT=
MAIL_FROM=
RESET_URL=http://localhost:5173/reset-password
PRIVATE_STORAGE_PATH=/home/ACCOUNT/vantiq-private-storage

# Spring Boot main application database (Neon neondb; do not add real values to source control).
# Runtime traffic uses the pooled URL. Inject the real URL, username, and password in the host secret store.
SPRING_PROFILES_ACTIVE=prod
# Use the Neon pooled host (-pooler) for application traffic.
DATABASE_URL=jdbc:postgresql://<pooled-host>/neondb?sslmode=require&channel_binding=require
# Direct, unpooled URL is only for an explicitly approved Flyway migration command; do not use for app traffic.
# The local URL fails closed if Flyway is accidentally enabled without a supplied direct Neon URL.
DATABASE_URL_UNPOOLED=jdbc:postgresql://localhost:5432/vantiq
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Keep startup migrations disabled. Run Flyway explicitly with DATABASE_URL_UNPOOLED after approval.
FLYWAY_ENABLED=false
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGIN=https://your-vercel-project.vercel.app
PORT=8080

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Copy this file to .env and replace APP_KEY with a secret generated by:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
